{
  "name": "temp-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:api:f3b": "newman run postman/mvp-ag-rbb-buzon.postman_collection.json -e postman/mvp-ag-rbb-local.postman_environment.json",
    "test:e2e": "cypress run --e2e",
    "test:e2e:local": "start-server-and-test dev http://localhost:3000 \"npm run test:e2e\"",
    "test:ci:tests": "npm run test:api:f3b && npm run test:e2e",
    "test:ci": "npm run lint && npm run build && start-server-and-test dev http://localhost:3000 \"npm run test:ci:tests\"",
    "audit:quick": "node scripts/audit.js --profile quick",
    "audit:standard": "node scripts/audit.js --profile standard",
    "audit:full": "node scripts/audit.js --profile full",
    "audit:security": "node scripts/audit.js --profile security",
    "audit:rls": "node scripts/checks/rls.js",
    "test:integration": "npm run test:api:f3b && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.3",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "25.2.2",
    "@types/react": "19.2.13",
    "cypress": "^15.10.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "newman": "^6.2.2",
    "prettier": "^3.8.1",
    "start-server-and-test": "^2.1.3"
  },
  "overrides": {
    "jose": "4.15.5",
    "node-forge": "1.3.2"
  }
}
