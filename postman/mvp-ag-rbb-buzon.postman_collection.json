	"item": [
		{
			"name": "00 – Auth / Tokens",
			"item": [
				{
					"name": "Login usuario A",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"",
									"pm.test(\"Login A devuelve 200\", function () {",
									"  pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Login A devuelve access_token\", function () {",
									"  pm.expect(json.access_token).to.exist;",
									"});",
									"",
									"pm.environment.set(\"ACCESS_TOKEN_A\", json.access_token);",
									"pm.environment.set(\"REFRESH_TOKEN_A\", json.refresh_token);",
									"",
									"pm.test(\"Tokens A guardados en environment\", function () {",
									"  pm.expect(pm.environment.get(\"ACCESS_TOKEN_A\")).to.exist;",
									"  pm.expect(pm.environment.get(\"REFRESH_TOKEN_A\")).to.exist;",
									"});",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "apikey",
								"value": "{{SUPABASE_ANON_KEY}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{TEST_EMAIL_A}}\",\n  \"password\": \"{{TEST_PASSWORD_A}}\"\n}\n"
						},
						"url": {
							"raw": "{{SUPABASE_URL}}/auth/v1/token?grant_type=password",
							"host": [
								"{{SUPABASE_URL}}"
							],
							"path": [
								"auth",
								"v1",
								"token"
							],
							"query": [
								{
									"key": "grant_type",
									"value": "password"
								}
							]
						}
					},
					"response": []
				},
