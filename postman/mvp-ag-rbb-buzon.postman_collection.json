		{
			"name": "10 – GET /api/sugerencias",
			"item": [
				{
					"name": "GET sin sesión → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 401\", function () {",
									"  pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Body contiene mensaje 'No hay sesión activa.'\", function () {",
									"  var jsonData;",
									"  try {",
									"    jsonData = pm.response.json();",
									"  } catch (e) {",
									"    pm.expect.fail(\"Respuesta no es JSON válido\");",
									"  }",
									"  pm.expect(jsonData).to.have.property('message');",
									"  pm.expect(jsonData.message).to.include('No hay sesión activa');",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/sugerencias",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"sugerencias"
							]
						}
					},
					"response": []
				},
				{
					"name": "GET listar sugerencias socio A",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status 200 OK\", () => pm.response.code === 200);\r",
									"\r",
									"pm.test(\"Respuesta es un array\", () => {\r",
									"    const json = pm.response.json();\r",
									"    pm.expect(Array.isArray(json)).to.be.true;\r",
									"});\r",
									"\r",
									"pm.test(\"Cada sugerencia tiene campos clave\", () => {\r",
									"    const json = pm.response.json();\r",
									"    json.forEach(item => {\r",
									"        pm.expect(item).to.have.property(\"titulo\");\r",
									"        pm.expect(item).to.have.property(\"contenido\");\r",
									"        pm.expect(item).to.have.property(\"estado\");\r",
									"    });\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/sugerencias",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"sugerencias"
							]
						}
					},
					"response": []
				}
			]
		},
