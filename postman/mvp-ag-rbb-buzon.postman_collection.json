      "name": "10 – GET /api/sugerencias",
      "item": [
        {
          "name": "GET sin sesión → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Body contiene mensaje 'No hay sesión activa.'\", function () {",
                  "  var jsonData;",
                  "  try {",
                  "    jsonData = pm.response.json();",
                  "  } catch (e) {",
                  "    pm.expect.fail(\"Respuesta no es JSON válido\");",
                  "  }",
                  "  pm.expect(jsonData).to.have.property('message');",
                  "  pm.expect(jsonData.message).to.include('No hay sesión activa');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/sugerencias",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "sugerencias"]
            }
          },
          "response": []
        },
        {
          "name": "GET listar sugerencias socio A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parsear respuesta JSON",
                  "const json = pm.response.json();",
                  "",
                  "// 1) Status 200",
                  "pm.test(\"Status 200 OK\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// 2) Body es array (puede ser [] o con datos)",
                  "pm.test(\"Body es un array\", () => {",
                  "  pm.expect(json).to.be.an(\"array\");",
                  "});",
                  "",
                  "// 3) Si hay elementos, validamos shape básico",
                  "if (json.length > 0) {",
                  "  const item = json[0];",
                  "",
                  "  pm.test(\"Item tiene campos esperados\", () => {",
                  "    pm.expect(item).to.have.property(\"id\");",
                  "    pm.expect(item).to.have.property(\"titulo\");",
                  "    pm.expect(item).to.have.property(\"contenido\");",
                  "    pm.expect(item).to.have.property(\"estado\");",
                  "    pm.expect(item).to.have.property(\"created_at\");",
                  "  });",
                  "",
                  "  pm.test(\"Item NO expone socio_id\", () => {",
                  "    pm.expect(item).to.not.have.property(\"socio_id\");",
                  "  });",
                  "} else {",
                  "  pm.test(\"Lista puede estar vacía (escenario válido)\", () => {",
                  "    pm.expect(json.length).to.eql(0);",
                  "  });",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN_A}}",
                  "type": "string"
