    {
      "name": "10 – GET /api/sugerencias",
      "item": [
        {
          "name": "GET sin sesión → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{API_BASE_URL}}/sugerencias",
              "host": ["{{API_BASE_URL}}"],
              "path": ["sugerencias"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Body contiene mensaje 'No hay sesión activa.'\", function () {",
                  "  var jsonData;",
                  "  try {",
                  "    jsonData = pm.response.json();",
                  "  } catch (e) {",
                  "    pm.expect.fail(\"Respuesta no es JSON válido\");",
                  "  }",
                  "  pm.expect(jsonData).to.have.property('message');",
                  "  pm.expect(jsonData.message).to.include('No hay sesión activa');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
