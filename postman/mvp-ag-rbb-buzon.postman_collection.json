		{
			"name": "10 – GET /api/sugerencias",
			"item": [
				{
					"name": "GET sin sesión → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"GET /api/sugerencias sin sesión responde 401\", function () {",
									"  pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Body indica que no hay sesión activa\", function () {",
									"  const json = pm.response.json();",
									"  pm.expect(json).to.be.an(\"object\");",
									"  pm.expect(json.message).to.eql(\"No hay sesión activa.\");",
									"});",
									""
