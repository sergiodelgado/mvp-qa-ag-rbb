      "name": "00 – Auth / Tokens",
      "item": [
        {
          "name": "Login usuario A (placeholder)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "// Validación de status",
                  "pm.test(\"Status 200 OK\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Validaciones mínimas de tokens",
                  "pm.test(\"access_token existe\", () => {",
                  "  pm.expect(json.access_token).to.exist;",
                  "  pm.expect(json.access_token).to.be.a(\"string\");",
                  "  pm.expect(json.access_token.length).to.be.greaterThan(20);",
                  "});",
                  "",
                  "pm.test(\"refresh_token existe\", () => {",
                  "  pm.expect(json.refresh_token).to.exist;",
                  "  pm.expect(json.refresh_token).to.be.a(\"string\");",
                  "  // Umbral relajado, opcional:",
                  "  pm.expect(json.refresh_token.length).to.be.greaterThan(5);",
                  "});",
                  "",
                  "// Guardar tokens en el environment activo",
                  "pm.environment.set(\"ACCESS_TOKEN_A\", json.access_token);",
                  "pm.environment.set(\"REFRESH_TOKEN_A\", json.refresh_token);",
                  "",
                  "pm.test(\"Variables de entorno A definidas\", () => {",
                  "  pm.expect(pm.environment.get(\"ACCESS_TOKEN_A\")).to.exist;",
                  "  pm.expect(pm.environment.get(\"REFRESH_TOKEN_A\")).to.exist;",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
